# @BotFather'dan alınan bot token'ı
BOT_TOKEN=

# İlan girmesine izin verilen Telegram kullanıcı ID'leri, virgülle ayrılmış (ör. 123456789,987654321)
# Kendi ID'nizi öğrenmek için Telegram'da @userinfobot'a yazın.
ALLOWED_TELEGRAM_IDS=

# Laravel sitesinin adresi (API istekleri buraya gider)
API_BASE_URL=http://ilkermax.test

# Laravel .env'deki BOT_API_KEY ile birebir aynı olmalı
API_KEY=

# İlan yayınlandıktan sonra kullanıcıya gösterilecek link için site adresi
SITE_URL=http://ilkermax.test
